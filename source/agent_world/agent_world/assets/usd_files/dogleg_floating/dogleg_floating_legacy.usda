#usda 1.0
(
    defaultPrim = "dogleg_floating_isaac"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "dogleg_floating_isaac" (
    variants = {
        string Physics = "PhysX"
        string Sensor = "Sensors"
    }
    prepend variantSets = ["Physics", "Sensor"]
)
{
    def Scope "loop_joints"
    {
        def PhysicsSphericalJoint "left_calf_coupler_closure_minus"
        {
            rel physics:body0 = </dogleg_floating_isaac/base_link/left_front2_link>
            rel physics:body1 = </dogleg_floating_isaac/base_link/left_front4_link>
            uniform bool physics:excludeFromArticulation = 1
            point3f physics:localPos0 = (-0.043210294, -0.051204205, -0.005)
            point3f physics:localPos1 = (-0.09615982, 0.009211305, -0.005)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

